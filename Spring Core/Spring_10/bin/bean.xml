	<bean id="manager" class="com.mainapp.Manager" lazy-init="true">
		<constructor-arg name="mngrId" value="1001"></constructor-arg>
		<constructor-arg name="mngrName" value="Vishvdeep"></constructor-arg>
	</bean>
	
	<bean id="employee" class="com.mainapp.Employee">
		<property name="eid" value="101"></property>
		<property name="ename" value="Ajay"></property>
		<property name="setOfBooks">
			<set>
				<value>Java</value>
				<value>Hibernate</value>
				<value>JDBC</value>
				<value>JDBC</value>
			</set>
		</property>
		<property name="mngr">
			<set>
				<ref bean="manager"/>
			</set>
		</property>
	</bean>
	
